# Smart-home controller credentials. Copy to .env and fill in. NEVER commit .env.

# Higoal (lights / blinds / boiler) — your Higoal app account
HIGOAL_USERNAME=
HIGOAL_PASSWORD=

# Electra central A/C — the "אלקטרה סמארט" app.
# Set ELECTRA_PHONE, then run:  python electra_cli.py request  (enter the SMS code)
#   python electra_cli.py token <otp>   -> fills IMEI + TOKEN below automatically.
ELECTRA_PHONE=
ELECTRA_IMEI=
ELECTRA_TOKEN=

# Midea split A/Cs ("SmartHome / MSmartHome" app = Midea OEM) are LOCAL LAN.
# No account needed — run:  python midea_cli.py discover  (writes midea_devices.json).
# These are only needed if discovery must authenticate against the Midea cloud:
MIDEA_ACCOUNT=
MIDEA_PASSWORD=
MIDEA_ACCOUNT_TYPE=MSmartHome
