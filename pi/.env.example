# --- Brain (required, all channels) ---
ANTHROPIC_API_KEY=your_anthropic_key_here
HOMIE_MODEL=claude-haiku-4-5-20251001

# --- Shared store ---
# local = text files under pi/.homie-state (default, used by tests + Mac harness)
# drive = Google Drive text files (system of record, reachable home + remote)
HOMIE_STORE=local
GOOGLE_SERVICE_ACCOUNT_PATH=../secrets/google-calendar.json
# Drive file IDs (share each file, Editor, with the service-account email; enable Drive API)
HOMIE_LIST_FILE_ID=
HOMIE_RECIPES_FILE_ID=
HOMIE_MEMORY_FILE_ID=

# --- Voice channel (Pi) — Deepgram owns STT/TTS ---
DEEPGRAM_API_KEY=your_deepgram_key_here
PORCUPINE_ACCESS_KEY=your_picovoice_key_here   # wake word
WAKE_WORD_PATH=hey-homie.ppn
HOMIE_TABLET_HTML=/tmp/homie_screen.html       # kiosk browser displays this file

# --- Recipe web search ---
TAVILY_API_KEY=your_tavily_key_here

# --- Telegram channel (remote) ---
TELEGRAM_BOT_TOKEN=your_bot_token_here
HOMIE_TELEGRAM_CHAT_ID=                         # target chat for "send it to Telegram"

# --- Shabbat times (Hebcal geonameid; 281184 = Jerusalem) ---
HOMIE_SHABBAT_GEONAME=281184

# --- Smart home (lights/blinds/AC) — the smarthome/ Flask server ---
# On the machine running server.py this default works; from the Pi point it at
# that machine's LAN address, e.g. http://192.168.68.55:8787
HOMIE_SMARTHOME_URL=http://localhost:8787

# --- Langfuse tracing (optional; traces every turn when set) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
