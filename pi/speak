#!/usr/bin/env python3
"""Simple TTS script for talking to people downstairs via SSH."""

import os
import sys
import tempfile
import subprocess
from pathlib import Path
from openai import OpenAI

# Load environment variables from .env file
from dotenv import load_dotenv
env_path = Path(__file__).parent / '.env'
load_dotenv(env_path)

# Initialize OpenAI client
client = OpenAI(api_key=os.getenv('OPENAI_API_KEY'))

def set_volume(percent):
    """Set system volume to specified percentage."""
    try:
        subprocess.run(['amixer', 'set', 'Master', f'{percent}%'],
                      check=True,
                      capture_output=True)
    except Exception as e:
        print(f"Warning: Could not set volume: {e}", file=sys.stderr)

def speak(text):
    """Convert text to speech and play it."""
    if not text.strip():
        return

    try:
        # Generate speech using OpenAI TTS
        response = client.audio.speech.create(
            model="tts-1",
            voice="nova",
            input=text,
            response_format="mp3"
        )

        # Save to temporary file and play
        with tempfile.NamedTemporaryFile(suffix=".mp3", delete=False) as f:
            f.write(response.content)
            temp_path = f.name

        # Play the audio (suppress all output)
        subprocess.run(["mpg123", "-q", "-C", temp_path],
                      check=True,
                      stdout=subprocess.DEVNULL,
                      stderr=subprocess.DEVNULL)

        # Clean up
        os.unlink(temp_path)

    except Exception as e:
        print(f"Error: {e}", file=sys.stderr)

def main():
    # Set volume to 90%
    set_volume(90)

    print("Speak script ready. Type messages and press Enter to speak them.")
    print("Press Ctrl+C to exit.")

    try:
        for line in sys.stdin:
            text = line.strip()
            if text:
                speak(text)
    except KeyboardInterrupt:
        print("\nExiting...")
        sys.exit(0)

if __name__ == "__main__":
    main()
